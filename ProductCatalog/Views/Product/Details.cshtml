@model ProductCatalog.Models.Product

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Product Details</title>
    <style>
        .detail { width: 60%; }
        dt { font-weight: bold; }
        dd { margin-bottom: 10px; }
    </style>
</head>
<body>
    <h2>Product Details</h2>
    <div class="detail">
        <dl>
            <dt>Product ID</dt>
            <dd>@Model.ProductId</dd>
            <dt>Product Name</dt>
            <dd>@Model.ProductName</dd>
            <dt>Price</dt>
            <dd>@String.Format("{0:C}", Model.Price)</dd>
            <dt>Category</dt>
            <dd>@Model.Category</dd>
        </dl>

        <p><a href="@Url.Action("Index", "Product")">Back to Catalog</a></p>
    </div>
</body>
</html>
